# Salin file ini menjadi .env lalu isi. JANGAN unggah .env ke GitHub atau LMS.

# Token bot dari @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz

# Personal Access Token GitHub (tanpa scope pun cukup untuk data publik)
GITHUB_TOKEN=ghp_isi_token_github_anda

# Chat ID admin (opsional). Jika diisi, hanya chat ini yang boleh memakai bot.
ADMIN_CHAT_ID=

# Penjadwalan dan kuota
JAM_JADWAL=19:00
JUMLAH_HARI=7
KUOTA_HARIAN=500
JEDA_DETIK=2.0

# Opsional: ubah cakupan pencarian
# QUERY_DASAR=claude-code skills in:name,description fork:false
# STARS_MIN=3
# TANGGAL_MULAI_CARI=2025-01-01
# AMBANG_RELEVAN=4
